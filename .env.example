# OpenAI API 配置示例
# 复制此文件为 .env 并填入实际值

# ============================================================================
# 必填配置
# ============================================================================

# OpenAI API Key（必填）
OPENAI_API_KEY=your-api-key-here

# ============================================================================
# 可选配置 - API 端点
# ============================================================================

# 自定义 API 地址（可选）
# 支持 Azure OpenAI、代理服务、兼容 OpenAI 的第三方服务等
# 留空则使用 OpenAI 官方地址
# OPENAI_BASE_URL=https://your-custom-endpoint.com/v1

# ============================================================================
# 可选配置 - 模型选择
# ============================================================================

# 模型名称（可选，默认: gpt-4o）
# 可选值: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, 或任何兼容的模型
# OPENAI_MODEL=gpt-4o

# ============================================================================
# 可选配置 - 输出目录
# ============================================================================

# 输出目录路径（可选，默认: .wiki）
# 重要：相对路径将基于 **被分析的代码仓库**，而非本项目目录
# 支持以下格式:
# 1. 相对路径（相对于被分析的代码仓库）: .wiki 或 output
#    示例：分析 /path/to/repo 时，.wiki 会创建 /path/to/repo/.wiki
# 2. 绝对路径: /Users/username/Documents/output 或 C:\Users\username\output
# OUTPUT_DIR=.wiki

# ============================================================================
# 可选配置 - 模型参数
# ============================================================================

# 温度参数（可选，默认: 0.7）
# 控制输出的随机性，范围 0.0-2.0
# 较低的值（如 0.2）使输出更确定和集中
# 较高的值（如 1.5）使输出更多样和创造性
# MODEL_TEMPERATURE=0.7

# Top-p 采样参数（可选，默认: 1.0）
# 核采样参数，范围 0.0-1.0
# 较低的值使输出更集中在高概率词汇
# MODEL_TOP_P=1.0

# 最大生成 token 数（可选，默认: 4096）
# 单次响应的最大 token 数量
# 根据模型支持的上下文长度调整
# MODEL_MAX_TOKENS=4096

# 启用流式响应（可选，默认: false）
# 某些 OpenAI 兼容 API（如腾讯云编码助手）强制要求流式响应
# 注意：仅对 OpenAI SDK 生效，Claude SDK 始终使用非流式
# ENABLE_STREAMING=false

# ============================================================================
# 使用示例
# ============================================================================

# 示例 1: 使用 OpenAI 官方 API
# OPENAI_API_KEY=sk-xxx...
# OPENAI_MODEL=gpt-4o
# OPENAI_TEMPERATURE=0.7

# 示例 2: 使用 Azure OpenAI Service
# OPENAI_API_KEY=your-azure-key
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# OPENAI_MODEL=gpt-4

# 示例 3: 使用本地部署的兼容模型（如 Ollama）
# OPENAI_API_KEY=dummy-key
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:14b
# MODEL_TEMPERATURE=0.5

# 示例 4: 使用腾讯云编码助手（强制流式响应）
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://webankcoding.copilot.qq.com/v2
# OPENAI_MODEL=your-model-name
# ENABLE_STREAMING=true
